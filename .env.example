# Required — your bot's token from the Discord Developer Portal
DISCORD_TOKEN=your-bot-token

# Everything below is optional — these defaults are already baked in.

# Staff-only channel where ticket threads are created
# SUPPORT_CHANNEL_ID=1549096181903401130

# Roles pinged when a General Support request opens
# GENERAL_ROLE_IDS=1449091238107283639,1473706134467510364

# Roles pinged when a Partnership Support request opens
# PARTNERSHIP_ROLE_IDS=1468302255181529295,1475109255945392229

# Optional extras:
# GUILD_ID=            # speeds up /close registration; auto-detected if empty
# STAFF_ROLE_ID=       # extra role allowed to use /close
# CLOSE_PING_ROLE_ID=  # role shown + pinged in the closing embed (e.g. Executive Board)
